# Copy this file to ".env" and fill in your own values. NEVER commit ".env" to GitHub.

# --- Django ---
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=UTC

# --- Database ---
# DB_ENGINE=mysql uses MySQL 8.4 (recommended). DB_ENGINE=sqlite is a quick fallback for trying the app.
DB_ENGINE=mysql
DB_NAME=hireflow
DB_USER=hireflow_user
DB_PASSWORD=Anjali@2124
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Email (disabled by default: emails are printed in the terminal instead) ---
EMAIL_ENABLED=False
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=HireFlow <no-reply@example.com>
